# ─────────────────────────────────────────────────────────────────────────────
# AI Trading Intelligence Terminal — environment
# Copy to .env and fill in. NEVER commit a real .env (see SECURITY.md).
# Every value below is read ONLY in packages/config. Nothing here reaches the
# browser: no credential is ever exposed as NEXT_PUBLIC_*.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forex_agent
# Integration tests only. MUST be a different database — the suite truncates it.
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forex_agent_test
# Migrations and DDL only, never application queries. On Neon this is the endpoint
# WITHOUT `-pooler` in the hostname; copy it from the console rather than editing the
# pooled string. Unset locally, where it falls back to DATABASE_URL. See DEPLOY.md.
DIRECT_DATABASE_URL=

# ── Jobs ────────────────────────────────────────────────────────────────────
# The shared secret an external scheduler presents as `Authorization: Bearer <secret>`
# when calling POST /api/jobs/tick. Generate like the secrets below; minimum 32 chars.
#
# REQUIRED in production. Unset, the endpoint fails closed and refuses every call —
# correct, and completely silent: the deployment serves pages and never runs a job.
# Locally you can leave it set to anything; scripts/tick.mjs presents the same value.
JOB_TRIGGER_SECRET=

# ── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# Generate with: openssl rand -base64 48   (min 32 chars each)
SESSION_SECRET=
CSRF_SECRET=

# ── AI: Google Gemini ───────────────────────────────────────────────────────
# An API key from Google AI Studio (https://aistudio.google.com/apikey).
# A consumer Gemini subscription grants NO programmatic access and will not work.
GEMINI_API_KEY=
# Verified 2026-08-30: 3.7-flash is persistently 503 on the free tier and
# 2.5-flash returns 404. 3.5 and 3.6 both work with responseSchema.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# ── Macro / economic data ───────────────────────────────────────────────────
# Free key: https://fredaccount.stlouisfed.org/apikeys  (120 req/min with key)
FRED_API_KEY=

# ── Market data (optional in V1: no fundamental factor consumes price) ──────
# Free plan: 8 req/min, 800 credits/day. XAU/USD availability on the free plan
# is UNCONFIRMED — verified empirically in Phase 7. See PRD_V1.md 7.1.
TWELVEDATA_API_KEY=
# Daily LBMA gold fixing fallback: https://data.nasdaq.com/
NASDAQ_DATA_LINK_API_KEY=

# ── Email (Resend free tier: 3,000/month, 100/day, one verified domain) ─────
RESEND_API_KEY=
# Fallback transport, used when RESEND_API_KEY is absent.
SMTP_URL=
# This project sends as onboarding@resend.dev and refuses any custom domain — see
# DEPLOY.md. A change here is a code change, deliberately.
REPORT_FROM_EMAIL=onboarding@resend.dev
REPORT_TO_EMAIL=
# The one address this project may send to: the Resend account signup address.
# Deliberately a separate variable from REPORT_TO_EMAIL — a guard that reads the
# value it is guarding compares a thing to itself and passes every time. Required
# whenever RESEND_API_KEY is set; an empty allowlist refuses every send.
RESEND_ACCOUNT_ADDRESS=
# The calendar the report’s day boundary follows: which civil day a run is filed
# under, and which analyses count as belonging to it.
#
# Market calculations remain ALWAYS UTC (master PRD 15) — freshness, z-scores and
# every threshold are unchanged by this. The line between the two is load-bearing:
# this variable decides labelling and selection, never arithmetic.
#
# America/New_York matches the data. Every fact here is anchored to US release and
# market calendars, and a UTC boundary files a run made after 20:00 ET under
# tomorrow while its contents describe today.
REPORT_TIMEZONE=America/New_York

# ── End-to-end tests (local only) ───────────────────────────────────────────
# The Playwright suite signs in as a real user against the local database. Create it
# with `node scripts/user-admin.mjs create <email>` before the first run.
#
# Both are REQUIRED — the spec has no fallback. A literal password in the spec would
# have worked, but it would need a gitleaks allowlist entry, and an allowlist entry is
# a small hole in a guard that has already caught real problems here. The scan stays
# absolute; setup costs one line.
E2E_EMAIL=e2e@example.test
E2E_PASSWORD=
